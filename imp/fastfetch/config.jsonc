{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {

      "1": "38;2;243;139;168",
      "2": "38;2;249;226;175",
      "3": "38;2;166;227;161",
      "4": "38;2;137;220;235",
      "5": "38;2;137;180;250",
      "6": "38;2;203;166;247",
      "7": "38;2;245;245;245",
      "8": "38;2;116;199;236",
      "9": "38;2;242;143;173"

    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "color": {
        "user": "243;139;168",
        "host": "137;180;250"
      }
    },
    "break",
    {
      "type": "custom",
      "format": "󰌢  {#green}OS"
    },
    {
      "type": "os",
      "key": "├ ",
      "keyColor": "cyan"
    },
    {
      "type": "cpu",
      "key": "├ ",
      "keyColor": "magenta"
    },
    {
      "type": "bios",
      "key": "├ ",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "├ ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "└ ",
      "keyColor": "blue"
    },
    "break",
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "square"
    }
  ]

}
